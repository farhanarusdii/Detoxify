<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Android 11+ package visibility: discover other apps that have a launcher icon -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".DetoxifyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Detoxify">

        <activity android:name=".ModeSelectionActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ParentChildPickerActivity"
            android:exported="false" />

        <activity
            android:name=".ParentConnectChildActivity"
            android:exported="false" />

        <activity
            android:name=".ChildPermissionsActivity"
            android:exported="false" />

        <activity
            android:name=".ParentDashboardActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ChildDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ReportsActivity"
            android:exported="false" />

        <activity
            android:name=".CompareChildrenActivity"
            android:exported="false" />

        <activity
            android:name=".BedtimeIdeasActivity"
            android:exported="false"
            android:showWhenLocked="true" />

        <activity
            android:name=".ApproveTimeRequestActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ParentReviewRequestsActivity"
            android:exported="false" />

        <activity
            android:name=".BlockAppsActivity"
            android:exported="false" />

        <activity
            android:name=".ManageAccountActivity"
            android:exported="false" />

        <!--
            lockTaskMode="always"  — lets startLockTask() pin this activity at the OS level.
            In lock-task mode the system disables Home, Recents, and the notification shade
            so the child cannot leave by any hardware or gesture.

            exported="true" + HOME intent-filter — required so that if the child somehow
            triggers the Home intent while pinned, the OS routes it back here instead of
            the real launcher (on some OEMs Home press in lock-task targets the default
            home app unless the pinned app also declares HOME category).
        -->
        <activity
            android:name=".PhoneLockedActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:lockTaskMode="if_whitelisted"
            android:theme="@style/Theme.Detoxify.LockScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".BlockMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".ParentTimeRequestService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".AppBlockAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>