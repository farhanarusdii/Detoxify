<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/detox_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Detoxify.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/space_8"
        android:text="@string/parent_picker_title"
        android:textColor="@color/detox_on_surface"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/space_4"
        android:paddingBottom="@dimen/space_12"
        android:text="@string/parent_picker_subtitle"
        android:textColor="@color/detox_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_picker_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_24"
        android:text="@string/parent_picker_empty"
        android:textColor="@color/detox_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/list_children"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/detox_outline"
        android:dividerHeight="1dp"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_child"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/parent_picker_add_child" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_continue_dashboard"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginBottom="@dimen/screen_padding"
        android:text="@string/parent_picker_continue" />

</LinearLayout>
