<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/detox_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        style="@style/Detoxify.Toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Parent Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16"
                style="@style/Detoxify.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👨‍👩‍👧"
                        android:textSize="20sp"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tv_parent_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connected to: Parent"
                        android:textSize="12sp"
                        android:textColor="@color/detox_text_secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Time Remaining Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16"
                style="@style/Detoxify.Card"
                app:cardBackgroundColor="@color/detox_primary_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Time Remaining Today"
                        android:textSize="14sp"
                        android:textColor="@color/detox_on_surface" />

                    <TextView
                        android:id="@+id/tv_time_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1h 45m"
                        android:textSize="44sp"
                        android:textStyle="bold"
                        android:textColor="@color/detox_on_primary_container"
                        android:layout_marginVertical="@dimen/space_8" />

                    <ProgressBar
                        android:id="@+id/progress_time"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="200dp"
                        android:layout_height="8dp"
                        android:progress="65"
                        android:progressTint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tv_used_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone used: 0h 45m of 2h 0m"
                        android:textSize="12sp"
                        android:textColor="@color/detox_forest"
                        android:layout_marginTop="@dimen/space_8" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Mood check-in -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16"
                style="@style/Detoxify.Card"
                app:cardBackgroundColor="@color/detox_primary_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😊"
                        android:textSize="24sp"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mood_card_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/detox_on_surface" />

                        <TextView
                            android:id="@+id/tv_mood_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mood_card_prompt"
                            android:textSize="12sp"
                            android:textColor="@color/detox_text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bedtime Status -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_bedtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16"
                style="@style/Detoxify.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😴"
                        android:textSize="24sp"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fun without a phone"
                            android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/detox_on_surface" />

                        <TextView
                            android:id="@+id/tv_bedtime_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap for ideas you can do with a grown-up instead of scrolling"
                            android:textSize="12sp"
                            android:textColor="@color/detox_text_secondary" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Today's Usage -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Activity"
                style="@style/Detoxify.SectionTitle"
                android:layout_marginBottom="@dimen/space_8" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16"
                style="@style/Detoxify.Card">

                <ListView
                    android:id="@+id/list_today_usage"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:padding="8dp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Request More Time Button -->
            <Button
                android:id="@+id/btn_request_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:text="Request More Time"
                android:textSize="16sp"
                style="@style/Widget.MaterialComponents.Button" />

            <!-- Switch to Parent Mode Button (Password Protected) -->
            <Button
                android:id="@+id/btn_switch_to_parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔐 Switch to Parent Mode"
                android:textSize="14sp"
                android:backgroundTint="@color/detox_tertiary"
                style="@style/Widget.MaterialComponents.Button" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Note: Parent mode requires password"
                android:textSize="10sp"
                android:textColor="@color/detox_text_secondary"
                android:gravity="center" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>