<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/detox_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Detoxify.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select apps to block:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/detox_on_surface"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_block_apps_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apps are loaded from your child’s phone after it opens Detoxify (syncs periodically)."
        android:textSize="13sp"
        android:textColor="@color/detox_text_secondary"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp">

        <ListView
            android:id="@+id/list_view_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/detox_surface" />

        <TextView
            android:id="@+id/block_apps_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/block_apps_empty_child"
            android:textColor="@color/detox_text_secondary"
            android:textSize="15sp" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_block_selected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Block Selected Apps"
        android:textSize="16sp"
        android:layout_margin="16dp" />

</LinearLayout>
