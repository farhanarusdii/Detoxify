<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/detox_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Detoxify.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_child_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/detox_on_surface"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/space_8" />

            <TextView
                android:id="@+id/tv_reports_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reports_subtitle_usage"
                android:textColor="@color/detox_text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="@dimen/space_16" />

            <LinearLayout
                android:id="@+id/section_weekly_monthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Weekly -->
            <TextView
                style="@style/Detoxify.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reports_weekly_section"
                android:layout_marginBottom="@dimen/space_8" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Detoxify.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reports_weekly_heading"
                        android:textSize="14sp"
                        android:textColor="@color/detox_text_secondary" />

                    <TextView
                        android:id="@+id/tv_weekly_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0h 0m"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="@color/detox_primary"
                        android:layout_marginTop="@dimen/space_4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reports_daily_avg_heading"
                        android:textSize="14sp"
                        android:textColor="@color/detox_text_secondary"
                        android:layout_marginTop="@dimen/space_12" />

                    <TextView
                        android:id="@+id/tv_daily_average"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0h 0m"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/detox_secondary"
                        android:layout_marginTop="@dimen/space_4" />

                    <TextView
                        android:id="@+id/tv_weekly_footnote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:textColor="@color/detox_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Monthly -->
            <TextView
                style="@style/Detoxify.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reports_monthly_section"
                android:layout_marginBottom="@dimen/space_8" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Detoxify.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/tv_month_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/detox_text_secondary" />

                    <TextView
                        android:id="@+id/tv_monthly_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0h 0m"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/detox_olive"
                        android:layout_marginTop="@dimen/space_4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:text="@string/reports_monthly_top_heading"
                        android:textStyle="bold"
                        android:textColor="@color/detox_on_surface"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/layout_monthly_top_apps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/space_8" />

                    <TextView
                        android:id="@+id/tv_monthly_footnote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:textColor="@color/detox_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_insights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Behaviour -->
            <TextView
                style="@style/Detoxify.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/insights_behavior_heading"
                android:layout_marginBottom="@dimen/space_8" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Detoxify.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/insights_risk_label"
                        android:textColor="@color/detox_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_risk_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/detox_primary" />

                    <TextView
                        android:id="@+id/tv_behavior_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:textColor="@color/detox_on_surface"
                        android:textSize="15sp"
                        android:lineSpacingMultiplier="1.15" />

                    <TextView
                        android:id="@+id/tv_overuse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:textColor="@color/detox_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_late_night"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textColor="@color/detox_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/insights_patterns_heading"
                        android:textStyle="bold"
                        android:textColor="@color/detox_on_surface" />

                    <TextView
                        android:id="@+id/tv_patterns"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textColor="@color/detox_on_surface"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mood -->
            <TextView
                style="@style/Detoxify.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/insights_mood_heading"
                android:layout_marginBottom="@dimen/space_8" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Detoxify.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/tv_mood_insight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/detox_on_surface"
                        android:textSize="15sp"
                        android:lineSpacingMultiplier="1.15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/mood_recent_heading"
                        android:textStyle="bold"
                        android:textColor="@color/detox_on_surface" />

                    <TextView
                        android:id="@+id/tv_mood_recent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textColor="@color/detox_text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.25" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
